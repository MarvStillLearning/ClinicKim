# Copy this file to ".env" then paste your own values from Supabase
# (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Supabase Edge Function secrets (configure in Supabase, not in the frontend .env)
# Comma-separated exact browser origins; include localhost for local frontend testing.
# CLINIC_APP_ORIGIN=http://localhost:5173,https://clinic.example.com
# RESEND_API_KEY=your-resend-api-key
# APPOINTMENT_FROM_EMAIL=Clinic <appointments@your-verified-domain.com>
# APPOINTMENT_NOTIFICATION_EMAIL=your-notification-email@example.com
